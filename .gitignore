# 数据集与派生产物一律不入库，只保留 data/samples 小样
data/*
!data/samples/
!data/samples/**

# 实验模型与调试 dump 不入库
*.pt
# L1：tools/ 下的一次性产物（构建日志、结果转储、随手脚本）不入库；
# 29 个 .py 与 tools/verify.ps1（回归门）保留——它们是工具，不是产物。
tools/*.txt
tools/*.log
tools/dl.ps1
__pycache__/
*.pyc

# 内部求职口径与规划，不对外发布
docs/_internal/

# 模型文件不入库（按 docs 脚本导出）
*.onnx
models/

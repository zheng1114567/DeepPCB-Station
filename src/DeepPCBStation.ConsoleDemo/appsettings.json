{
  "camera": {
    "mode": "PairedFilePlayback",
    "width": 640,
    "height": 640,
    "playbackRootDir": "data/samples",
    "playbackManifest": "Manifest.txt",
    "playbackLoop": true
  },
  "detection": {
    "engine": "Halcon",
    "diffThreshold": 30,
    "minBlobArea": 40,
    "maxBlobArea": 8000,
    "openRadius": 1
  },
  "tcp": {
    "port": 9100,
    "enabled": false,
    "timeoutMs": 5000,
    "testInjectDelayMs": 0
  },
  "storage": {
    "outputRoot": "results",
    "saveImages": true,
    "logFormat": "both"
  }
}

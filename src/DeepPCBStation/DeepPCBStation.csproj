<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeepPCBStation</RootNamespace>
    <StartupObject>DeepPCBStation.App</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeepPCBStation.Core\DeepPCBStation.Core.csproj" />
  </ItemGroup>
  <!-- L3：polyfill 与 Core 链接共享同一份文件（原 WPF 侧另有副本，靠 BOM 差异都会漏改）。
     internal 类型每程序集各得一份拷贝，无跨程序集冲突。 -->
  <ItemGroup>
    <Compile Include="..\DeepPCBStation.Core\Polyfills\IsExternalInit.cs" Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

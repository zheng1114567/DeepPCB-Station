<Window x:Class="DeepPCBStation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepPCB-Station · 登录"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="470" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Grid>
    <Border Style="{StaticResource Card}" CornerRadius="0" Padding="32,30" Width="384"
            VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel>
        <Border Width="44" Height="44" CornerRadius="0" Background="{StaticResource AccentBrush}"
                HorizontalAlignment="Center">
          <TextBlock Text="DP" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="DeepPCB-Station" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{StaticResource InkBrush}" Margin="0,14,0,0"/>
        <TextBlock Text="PCB AOI 工位 · 请登录" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,24"/>

        <TextBlock Text="用户名" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
        <TextBox x:Name="UserBox" Height="36" FontSize="14" Margin="0,0,0,14"
                 KeyDown="UserBox_KeyDown"/>

        <TextBlock Text="密码" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PwdBox" Height="36" FontSize="14" Margin="0,0,0,10"
                     KeyDown="PwdBox_KeyDown"/>

        <TextBlock x:Name="ErrorText" Text="" FontSize="11.5" Foreground="{StaticResource NgBrush}"
                   Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Button Content="登 录" Height="40" FontSize="14" Style="{StaticResource PrimaryButton}"
                Click="Login_Click"/>

        <Border Style="{StaticResource Hairline}" Margin="0,20,0,12"/>
        <TextBlock Text="忘记密码请联系管理员。" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>

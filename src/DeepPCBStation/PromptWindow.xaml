<Window x:Class="DeepPCBStation.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="380" Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <StackPanel Margin="20">
    <TextBlock Text="{Binding PromptText}" FontSize="13" Margin="0,0,0,8"/>
    <TextBox x:Name="InputBox" Height="32" FontSize="14" VerticalContentAlignment="Center"
             KeyDown="InputBox_KeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Width="76" Height="30" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="确定" Width="76" Height="30" Style="{StaticResource PrimaryButton}" IsDefault="True"
              Click="Ok_Click"/>
    </StackPanel>
  </StackPanel>
</Window>

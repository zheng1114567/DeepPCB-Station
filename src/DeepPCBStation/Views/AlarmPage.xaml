<UserControl x:Class="DeepPCBStation.Views.AlarmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 操作条 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="只看未确认" IsChecked="{Binding OnlyUnacked}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MicroLabel}" Margin="18,0,0,0"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding AckError}" Style="{StaticResource MicroLabel}" Margin="14,0,0,0"
                     Foreground="{StaticResource NgBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="320"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="刷新" Height="32" Padding="16,0" Command="{Binding RefreshCommand}"/>
          <Button Content="确认所选" Height="32" Padding="14,0" Margin="8,0,0,0"
                  Command="{Binding AckSelectedCommand}"
                  IsEnabled="{Binding CanAckSelected}"
                  ToolTip="确认所选告警（记入审计）；严重告警需工程师或管理员"/>
          <Button Content="全部确认" Height="32" Padding="14,0" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding AckAllCommand}"
                  IsEnabled="{Binding CanAckAll}"
                  ToolTip="确认全部未确认告警；无未确认项时置灰，无权限的严重告警会被跳过并提示"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 记录表 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,13,16,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource SectionMark}"/>
            <TextBlock Text="告警与事件" Style="{StaticResource SectionTitle}"/>
          </StackPanel>
          <TextBlock Text="未确认告警在顶栏闪烁；确认后转为历史记录"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{StaticResource MicroLabel}"/>
        </Grid>

        <Grid Grid.Row="1">
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="11.5"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="级别" Binding="{Binding SeverityText}" Width="64">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding SeverityBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="来源 · 代码" Binding="{Binding SourceCode}" Width="190">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding SourceCode}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
              <DataGridTextColumn Header="次数" Binding="{Binding OccurrencesText}" Width="56">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="11.5"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="状态" Binding="{Binding AckText}" Width="170">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAcked}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource NgBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="13" Foreground="{StaticResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

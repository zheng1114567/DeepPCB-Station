<Window x:Class="DeepPCBStation.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepPCB-Station · 修改密码"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="470" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Grid>
    <Border Style="{StaticResource Card}" CornerRadius="0" Padding="32,26" Width="384"
            VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel>
        <TextBlock Text="修改密码" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="SubtitleText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,20" TextWrapping="Wrap"
                   TextAlignment="Center"/>

        <TextBlock Text="账号" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
        <TextBox x:Name="UserBox" Height="34" FontSize="13" Margin="0,0,0,12" IsReadOnly="True"
                 Foreground="{StaticResource MutedBrush}"/>

        <TextBlock Text="当前密码" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
        <PasswordBox x:Name="OldBox" Height="34" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="新密码（至少 8 位，含字母与数字）" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
        <PasswordBox x:Name="NewBox" Height="34" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="确认新密码" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
        <PasswordBox x:Name="ConfirmBox" Height="34" FontSize="13" Margin="0,0,0,10"/>

        <TextBlock x:Name="ErrorText" Text="" FontSize="11.5" Foreground="{StaticResource NgBrush}"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="取 消" Height="38" FontSize="13"
                  Style="{StaticResource GhostButton}" Click="Cancel_Click" x:Name="CancelButton"/>
          <Button Grid.Column="2" Content="确认修改" Height="38" FontSize="13"
                  Style="{StaticResource PrimaryButton}" Click="Submit_Click"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>

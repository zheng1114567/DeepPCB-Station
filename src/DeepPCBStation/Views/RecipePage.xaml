<UserControl x:Class="DeepPCBStation.Views.RecipePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="ParamTemplate">
      <Border Width="392" Padding="6,3" CornerRadius="0" Background="Transparent">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Label}" Width="236" FontSize="11.5" VerticalAlignment="Center"
                     Foreground="{StaticResource InkSoftBrush}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Label}"/>
          <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="96" Height="26"
                   FontSize="11.5" VerticalContentAlignment="Center" Padding="6,0">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBool}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
          <CheckBox IsChecked="{Binding ValueBool}" VerticalAlignment="Center" Margin="0,0,0,0">
            <CheckBox.Style>
              <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBool}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </CheckBox.Style>
          </CheckBox>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="272"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左：配方列表 + 操作 -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,13,16,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource SectionMark}"/>
            <TextBlock Text="配方列表" Style="{StaticResource SectionTitle}"/>
          </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16">
          <Button Content="设为当前配方" Height="32" Margin="0,0,0,6" Style="{StaticResource PrimaryButton}"
                  Command="{Binding SelectCurrentCommand}" IsEnabled="{Binding CanSetCurrent}" FontSize="12"/>
          <Button Content="保存为新版本" Height="32" Margin="0,0,0,6"
                  Command="{Binding SaveNewVersionCommand}" IsEnabled="{Binding CanEdit}" FontSize="12"/>
          <Button Content="另存为新配方" Height="32"
                  Command="{Binding SaveAsNewCommand}" IsEnabled="{Binding CanEdit}" FontSize="12"/>
          <TextBlock Text="{Binding WarnText}" FontSize="10.5" Foreground="{StaticResource WarnBrush}"
                     TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                 Background="Transparent" BorderThickness="0" Margin="8,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,3" ToolTip="{Binding Display}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="当前" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource InkSoftBrush}"/>
                </DockPanel>
                <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" · v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右：参数编辑 -->
    <Border Grid.Column="2" Style="{StaticResource Card}">
      <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasEditing}" Value="False">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="请选择左侧配方" FontSize="13" Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="查看并编辑参数、版本与备注" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <DockPanel>
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasEditing}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
        <!-- 头部：当前编辑对象 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SubBrush}" CornerRadius="0"
                Padding="12,10" Margin="0,0,0,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SectionMark}"/>
                <TextBlock Text="参数编辑器" Style="{StaticResource SectionTitle}"/>
              </StackPanel>
              <TextBlock Text="{Binding EditingHeaderText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="{Binding HashDisplay}" FontSize="10.5" FontFamily="Consolas"
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            <TextBlock Text="备注" Style="{StaticResource MicroLabel}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Height="52" FontSize="11.5"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     IsEnabled="{Binding CanEdit}" Padding="8,5"/>
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="0"
                        Margin="0,0,0,12" Background="{StaticResource PanelBrush}">
                  <StackPanel>
                    <Border Background="{StaticResource SubBrush}" CornerRadius="0" Padding="12,8"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource InkSoftBrush}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ParamTemplate}"
                                  Margin="8,6,8,8">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

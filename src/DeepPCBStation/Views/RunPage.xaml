<UserControl x:Class="DeepPCBStation.Views.RunPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:DeepPCBStation.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============ 顶部告警条（仅在异常时出现，不占常态版面） ============ -->
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <Border Background="{StaticResource NgSoftBrush}" BorderBrush="{StaticResource NgBrush}"
              BorderThickness="1" Padding="10,5" Margin="0,0,0,6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasStorageIssue}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource NgBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding StorageIssueText}" TextWrapping="Wrap" FontSize="11.5"
                     FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBorderBrush}"
              BorderThickness="1" Padding="10,5">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding EngineWarnText}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding EngineWarnText}" TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{StaticResource InkSoftBrush}"/>
      </Border>
    </StackPanel>

    <!-- ============ 主体：图像 | 判定+明细 ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="368"/>
      </Grid.ColumnDefinitions>

      <!-- 图像区 -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
          </Grid.RowDefinitions>

          <!-- 图像工具条 -->
          <Border Grid.Row="0" Background="{StaticResource MenuBarBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="适应窗口" Style="{StaticResource ImageToolButton}" Click="FitView_Click"/>
                <Button Content="1 : 1" Style="{StaticResource ImageToolButton}" Click="ResetView_Click"/>
                <Button x:Name="CrosshairButton" Content="十字线" Style="{StaticResource ImageToolButton}"
                        Click="ToggleCrosshair_Click"/>
                <Border Style="{StaticResource VLine}"/>
                <TextBlock Text="partId" Style="{StaticResource LampLabel}" Margin="0,0,5,0"/>
                <TextBox x:Name="PartIdBox" Width="110" Height="22" FontSize="11"
                         VerticalContentAlignment="Center"
                         Text="{Binding PartIdText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="PartIdBox_OnKeyDown" ToolTip="扫码枪回车即开检（F2 聚焦）"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,10,0">
                <Border Width="8" Height="8" Background="{StaticResource OpenLegendBrush}" Margin="0,0,4,0"/>
                <TextBlock Text="open" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                <Border Width="8" Height="8" Background="{StaticResource MousebiteLegendBrush}" Margin="0,0,4,0"/>
                <TextBlock Text="mousebite" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                <Border Width="8" Height="8" Background="{StaticResource OtherLegendBrush}" Margin="0,0,4,0"/>
                <TextBlock Text="其它四类" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>

              <TextBlock Grid.Column="2" Text="640 × 640 · 8 bit" FontSize="10.5"
                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- 视口 -->
          <Border Grid.Row="1" Background="{StaticResource ViewportBrush}" ClipToBounds="True">
            <ctrl:ZoomBorder x:Name="Zoom">
              <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                <TextBlock Text="等待采图…" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#8A929A"
                           Visibility="{Binding PreviewPlaceholderVisibility}"/>
                <Grid x:Name="Crosshair" IsHitTestVisible="False">
                  <Rectangle Width="1" Fill="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                  <Rectangle Height="1" Fill="#66FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Grid>
              </Grid>
            </ctrl:ZoomBorder>
          </Border>

          <!-- 图像页脚 -->
          <Border Grid.Row="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
              <TextBlock Text="{Binding LastIdsText}" FontFamily="Consolas" FontSize="10.5"
                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="耗时" Style="{StaticResource LampLabel}" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding LastElapsedText}" FontFamily="Consolas" FontSize="10.5"
                           Foreground="{StaticResource InkSoftBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding EngineNameText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- 右列：判定 + 缺陷明细 + 参数 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 判定 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10">
          <StackPanel>
            <UniformGrid Columns="3" Height="44">
              <Border Background="{Binding OkLampBackground}" BorderBrush="#40000000" BorderThickness="1"
                      Margin="0,0,4,0">
                <TextBlock Text="OK" FontSize="15" FontWeight="Bold" Foreground="{Binding OkLampForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Background="{Binding NgLampBackground}" BorderBrush="#40000000" BorderThickness="1"
                      Margin="2,0,2,0">
                <TextBlock Text="NG" FontSize="15" FontWeight="Bold" Foreground="{Binding NgLampForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Background="{Binding FaultLampBackground}" BorderBrush="#40000000" BorderThickness="1"
                      Margin="4,0,0,0">
                <TextBlock Text="FAULT" FontSize="13" FontWeight="Bold" Foreground="{Binding FaultLampForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </UniformGrid>

            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LastVerdict}" FontSize="14" FontWeight="Bold"
                           Foreground="{Binding VerdictBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource InkSoftBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0">
                  <Run Text="检出"/>
                  <Run Text="{Binding LastDefectCount, Mode=OneWay}"/>
                  <Run Text="处"/>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding PartIdText}" FontFamily="Consolas" FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           MaxWidth="120" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>

            <TextBlock Text="{Binding ChangeoverText}" Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ChangeoverConfirmed}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- 缺陷明细 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,8,0,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="24"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelHead}">
              <TextBlock Text="缺陷明细" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
            </Border>
            <Grid Grid.Row="1">
              <TextBlock Text="本片无缺陷" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding LastDefects.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <DataGrid ItemsSource="{Binding LastDefects}" AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                        SelectionMode="Single" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="26">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="11"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="类型" Width="78">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding TypeBrush}" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="X" Binding="{Binding X}" Width="40"/>
                  <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="40"/>
                  <DataGridTextColumn Header="W" Binding="{Binding W}" Width="34"/>
                  <DataGridTextColumn Header="H" Binding="{Binding H}" Width="34"/>
                  <DataGridTextColumn Header="置信" Binding="{Binding ConfText}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Grid>
        </Border>

        <!-- 本次参数 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="24"/>
              <RowDefinition Height="22"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelHead}">
              <TextBlock Text="本次参数" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Background="#F0F2F4" BorderBrush="{StaticResource GridLineBrush}"
                    BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="参数" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="值" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding ParamRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1">
                    <Grid Height="21">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="11"
                                 Foreground="{StaticResource InkSoftBrush}" Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="11"
                                 Foreground="{StaticResource InkBrush}" Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

<UserControl x:Class="DeepPCBStation.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 顶栏：保存 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="保存设置" Height="32" Padding="22,0"
                Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"
                IsEnabled="{Binding CanEdit}"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource SectionMark}"/>
          <TextBlock Text="工位参数" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{Binding WarnText}" VerticalAlignment="Center" FontSize="11.5"
                     Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="12,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
      <StackPanel>
        <!-- 相机 / 检测 / TCP -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SectionMark}"/>
                <TextBlock Text="设备与通信" Style="{StaticResource SectionTitle}"/>
              </StackPanel>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="相机模式" Style="{StaticResource MicroLabel}" Margin="0,0,10,14"/>
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding CameraModes}"
                        SelectedItem="{Binding CameraMode}" IsEnabled="{Binding CanEdit}" Margin="0,0,28,14"/>

              <TextBlock Grid.Row="0" Grid.Column="2" Text="检测引擎" Style="{StaticResource MicroLabel}" Margin="0,0,10,14"/>
              <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Engines}"
                        SelectedItem="{Binding Engine}" IsEnabled="{Binding CanEdit}" Margin="0,0,28,14"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="TCP 端口" Style="{StaticResource MicroLabel}" Margin="0,0,10,0"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TcpPort}" IsEnabled="{Binding CanEdit}" Margin="0,0,28,0"/>

              <TextBlock Grid.Row="1" Grid.Column="2" Text="超时（ms）" Style="{StaticResource MicroLabel}" Margin="0,0,10,0"/>
              <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding TcpTimeoutMs}" IsEnabled="{Binding CanEdit}" Margin="0,0,28,0"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <CheckBox Content="启用 TCP 握手" IsChecked="{Binding TcpEnabled}"
                        IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"/>
              <CheckBox Content="保存原图 / 叠图" IsChecked="{Binding SaveImages}"
                        IsEnabled="{Binding CanEdit}" Margin="28,0,0,0" VerticalAlignment="Center"/>
              <CheckBox Content="严重告警声音" IsChecked="{Binding AlarmSound}"
                        IsEnabled="{Binding CanEdit}" Margin="28,0,0,0" VerticalAlignment="Center"
                        ToolTip="默认关闭；开启后仅在新的一次严重告警时响一声（保存后立即生效）"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 存储 -->
        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SectionMark}"/>
                <TextBlock Text="存储与路径" Style="{StaticResource SectionTitle}"/>
              </StackPanel>
              <TextBlock Text="{Binding DiskSpaceText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Style="{StaticResource MicroLabel}"/>
            </Grid>

            <TextBlock Text="results 输出目录" Style="{StaticResource MicroLabel}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding OutputRootText, Mode=OneWay}" IsEnabled="False" FontFamily="Consolas" FontSize="11.5"/>
            <TextBlock Text="配置文件路径" Style="{StaticResource MicroLabel}" Margin="0,12,0,5"/>
            <TextBox Text="{Binding ConfigPathText, Mode=OneWay}" IsEnabled="False" FontFamily="Consolas" FontSize="11.5"/>
          </StackPanel>
        </Border>

        <!-- 数据库 -->
        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SectionMark}"/>
                <TextBlock Text="数据库" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="SQLite" Style="{StaticResource MicroLabel}" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Text="{Binding DbCountsText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Style="{StaticResource MicroLabel}"/>
            </Grid>

            <TextBox Text="{Binding DbPathText, Mode=OneWay}" IsEnabled="False" FontFamily="Consolas" FontSize="11.5"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="导入历史结果" Height="32" Padding="14,0" ToolTip="扫描 results 目录的 sidecar JSON，写入数据库（重复项自动跳过）"
                      Style="{StaticResource PrimaryButton}" Command="{Binding ImportHistoryCommand}"
                      IsEnabled="{Binding CanImport}"/>
              <Button Content="刷新统计" Height="32" Padding="14,0" Margin="8,0,0,0"
                      Command="{Binding RefreshDbStatsCommand}"/>
              <Button Content="数据库写入测试" Height="32" Padding="14,0" Margin="8,0,0,0"
                      Command="{Binding TestDbWriteCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ImportStatusText}" FontSize="11.5" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}"/>
          </StackPanel>
        </Border>

        <!-- 快捷目录 -->
        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,12">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="关于" Height="30" Padding="14,0"
                    Command="{Binding ShowAboutCommand}"
                    ToolTip="版本、当前登录身份、数据来源与质量债说明"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="快捷打开" Style="{StaticResource MicroLabel}" Margin="0,0,12,0"/>
              <Button Content="results" Height="30" Padding="14,0" Command="{Binding OpenResultsFolderCommand}"/>
              <Button Content="reports" Height="30" Padding="14,0" Margin="8,0,0,0" Command="{Binding OpenReportsFolderCommand}"/>
              <Button Content="数据库目录" Height="30" Padding="14,0" Margin="8,0,0,0" Command="{Binding OpenDbFolderCommand}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl x:Class="DeepPCBStation.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="1.2*"/>
    </Grid.ColumnDefinitions>

    <!-- 用户管理 -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,13,16,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource SectionMark}"/>
            <TextBlock Text="用户管理" Style="{StaticResource SectionTitle}"/>
          </StackPanel>
          <Button HorizontalAlignment="Right" Content="刷新" Height="26" Padding="10,0"
                  FontSize="11" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
          <StackPanel>
            <UniformGrid Columns="4">
              <Button Content="添加用户" Height="30" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"
                      Command="{Binding AddUserCommand}" FontSize="12"/>
              <Button Content="修改角色" Height="30" Margin="3,0,3,0"
                      Command="{Binding SetRoleCommand}" IsEnabled="{Binding HasSelection}" FontSize="12"/>
              <Button Content="重置密码" Height="30" Margin="3,0,3,0"
                      Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding HasSelection}" FontSize="12"/>
              <Button Content="删除" Height="30" Margin="6,0,0,0" Style="{StaticResource DangerButton}"
                      Command="{Binding RemoveUserCommand}" IsEnabled="{Binding HasSelection}" FontSize="12"/>
            </UniformGrid>
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="110"/>
            <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="80"/>
            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="150"/>
            <DataGridTextColumn Header="最近登录" Binding="{Binding LastLogin}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!-- 审计日志 -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,13,16,10">
          <Border Style="{StaticResource SectionMark}"/>
          <TextBlock Text="审计日志" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="最近 200 条" Style="{StaticResource MicroLabel}" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Audit}"
                  AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding TsText}" Width="118"/>
            <DataGridTextColumn Header="用户" Binding="{Binding Username}" Width="90"/>
            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="130"/>
            <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
